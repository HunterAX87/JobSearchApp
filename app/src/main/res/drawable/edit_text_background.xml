<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/grey2"/> <!-- Цвет фона -->
            <stroke android:width="20dp" android:color="@color/red"/> <!-- Цвет обводки по умолчанию -->
            <corners android:radius="8dp"/> <!-- Закругление углов -->
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/grey2"/> <!-- Цвет фона -->
            <stroke android:width="5dp" android:color="@color/red"/> <!-- Цвет обводки по умолчанию -->
            <corners android:radius="8dp"/> <!-- Закругление углов -->
        </shape>
    </item>
</selector>